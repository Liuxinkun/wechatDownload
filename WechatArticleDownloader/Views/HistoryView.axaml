<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:WechatArticleDownloader.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="660"
             x:Class="WechatArticleDownloader.Views.HistoryView">
    <Border Margin="10">
        <suki:GlassCard>
            <suki:GroupBox>
                <suki:GroupBox.Header>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <avalonia:MaterialIcon Kind="History" />
                            <TextBlock Text="下载记录" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="Basic Rounded" Cursor="Hand"
                                Command="{Binding RefreshCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <avalonia:MaterialIcon Kind="Refresh" />
                                <TextBlock Text="刷新" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </suki:GroupBox.Header>

                <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}" Margin="0 4 0 0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="4 6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="14" Margin="0 3 0 0">
                                        <TextBlock Text="{Binding Account}" Opacity="0.75" />
                                        <TextBlock Text="{Binding FetchedAt}" Opacity="0.75" />
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <avalonia:MaterialIcon Kind="Image" Width="13" Height="13" Opacity="0.75" />
                                            <TextBlock Text="{Binding Images}" Opacity="0.75" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <avalonia:MaterialIcon Kind="PlayCircle" Width="13" Height="13" Opacity="0.75" />
                                            <TextBlock Text="{Binding Videos}" Opacity="0.75" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <avalonia:MaterialIcon Kind="MusicNote" Width="13" Height="13" Opacity="0.75" />
                                            <TextBlock Text="{Binding Audios}" Opacity="0.75" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding TotalSizeText}" Opacity="0.75" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="Basic Rounded" Cursor="Hand" Margin="8 0"
                                        Command="{Binding $parent[ListBox].((vm:HistoryViewModel)DataContext).OpenFolderCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <avalonia:MaterialIcon Kind="FolderOpen" Width="15" Height="15" />
                                        <TextBlock Text="打开目录" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Classes="Basic Rounded" Cursor="Hand"
                                        IsVisible="{Binding HasReport}"
                                        Command="{Binding $parent[ListBox].((vm:HistoryViewModel)DataContext).OpenReportCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <avalonia:MaterialIcon Kind="FileChart" Width="15" Height="15" />
                                        <TextBlock Text="打开报告" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </suki:GroupBox>
        </suki:GlassCard>
    </Border>
</UserControl>
