<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                 xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                 xmlns:vm="clr-namespace:WechatArticleDownloader.ViewModels"
                 xmlns:views="clr-namespace:WechatArticleDownloader.Views"
                 mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="680"
                 x:Class="WechatArticleDownloader.Views.MainWindow"
                 x:DataType="vm:MainWindowViewModel"
                 MinWidth="980"
                 MinHeight="640"
                 CanResize="True"
                 CanMove="True"
                 CanMinimize="True"
                 IsTitleBarVisible="True"
                 WindowStartupLocation="CenterScreen"
                 Title="公众号文章资源下载器"
                 FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI">

    <suki:SukiWindow.Hosts>
        <suki:SukiToastHost Manager="{Binding ToastManager}" />
        <suki:SukiDialogHost Manager="{Binding DialogManager}" />
    </suki:SukiWindow.Hosts>

    <suki:SukiWindow.MenuItems>
        <MenuItem Header="模式">
            <MenuItem Command="{Binding ToggleBaseThemeCommand}" Header="{Binding BaseThemeName}">
                <MenuItem.Icon>
                    <avalonia:MaterialIcon Kind="Lightbulb" />
                </MenuItem.Icon>
            </MenuItem>
        </MenuItem>
        <MenuItem Header="项目">
            <MenuItem Command="{Binding OpenRepoCommand}" Header="设计参考 LottieViewConvert">
                <MenuItem.Icon>
                    <avalonia:MaterialIcon Kind="Github" />
                </MenuItem.Icon>
            </MenuItem>
        </MenuItem>
    </suki:SukiWindow.MenuItems>

    <suki:SukiSideMenu IsSearchEnabled="False">

        <suki:SukiSideMenu.HeaderContent>
            <StackPanel>
                <avalonia:MaterialIcon Kind="CloudDownload"
                                       Width="44" Height="44"
                                       HorizontalAlignment="Center"
                                       Margin="0,16,0,10" />
                <TextBlock HorizontalAlignment="Center"
                           Text="公众号资源下载器"
                           FontWeight="Bold"
                           FontSize="14"
                           Margin="0,0,0,24" />
            </StackPanel>
        </suki:SukiSideMenu.HeaderContent>

        <suki:SukiSideMenuItem Header="下载">
            <suki:SukiSideMenuItem.Icon>
                <avalonia:MaterialIcon Kind="Download" />
            </suki:SukiSideMenuItem.Icon>
            <suki:SukiSideMenuItem.PageContent>
                <views:HomeView DataContext="{Binding Home}" />
            </suki:SukiSideMenuItem.PageContent>
        </suki:SukiSideMenuItem>

        <suki:SukiSideMenuItem Header="下载记录">
            <suki:SukiSideMenuItem.Icon>
                <avalonia:MaterialIcon Kind="History" />
            </suki:SukiSideMenuItem.Icon>
            <suki:SukiSideMenuItem.PageContent>
                <views:HistoryView DataContext="{Binding History}" />
            </suki:SukiSideMenuItem.PageContent>
        </suki:SukiSideMenuItem>

        <suki:SukiSideMenuItem Header="设置">
            <suki:SukiSideMenuItem.Icon>
                <avalonia:MaterialIcon Kind="Cog" />
            </suki:SukiSideMenuItem.Icon>
            <suki:SukiSideMenuItem.PageContent>
                <views:SettingView DataContext="{Binding Settings}" />
            </suki:SukiSideMenuItem.PageContent>
        </suki:SukiSideMenuItem>

        <suki:SukiSideMenuItem Header="关于">
            <suki:SukiSideMenuItem.Icon>
                <avalonia:MaterialIcon Kind="Information" />
            </suki:SukiSideMenuItem.Icon>
            <suki:SukiSideMenuItem.PageContent>
                <views:AboutView DataContext="{Binding About}" />
            </suki:SukiSideMenuItem.PageContent>
        </suki:SukiSideMenuItem>

        <suki:SukiSideMenu.FooterContent>
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock HorizontalAlignment="Center"
                           Text="UI 设计借鉴 LottieViewConvert"
                           FontSize="11"
                           Opacity="0.7" />
            </StackPanel>
        </suki:SukiSideMenu.FooterContent>
    </suki:SukiSideMenu>

</suki:SukiWindow>
